{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "cd ../backend && . venv/bin/activate && python -m uvicorn app.main:app --reload --host 0.0.0.0",
    "dev:all": "fuser -k 8000/tcp 5173/tcp 5174/tcp 5175/tcp 5176/tcp 2>/dev/null || true && sleep 2 && concurrently \"npm run dev\" \"npm run dev:backend\" --names \"frontend,backend\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.5",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
